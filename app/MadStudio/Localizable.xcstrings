    "Компрессор начинает с %lld дБ, усиление +%lld дБ — тихие слова подтянуты, громкие не перегружают.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compressor starts at %lld dB, gain +%lld dB — quiet words are lifted, loud ones don't clip."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компрессор начинает с %lld дБ, усиление +%lld дБ — тихие слова подтянуты, громкие не перегружают."
          }
        }
      }
    },
    "Компрессор: порог": {
